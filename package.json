{
  "name": "dream-transmission",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-manifest": "if [ -d \"public/music\" ]; then bun scripts/generate-manifest.js; else echo \"Skipping manifest generation: public/music not found\"; fi",
    "predev": "bun run generate-manifest",
    "prebuild": "bun run generate-manifest",
    "dev": "vite",
    "build": "vite build",
    "build:worker": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "cf:status": "../scripts/cf-portfolio.sh status dream-transmission",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint:fix": "oxlint --fix . && oxfmt"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "animejs": "^4.5.0",
    "framer-motion": "^12.42.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.22.0",
    "postprocessing": "^6.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "postcss": "8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "8.1.0",
    "wrangler": "4.105.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
